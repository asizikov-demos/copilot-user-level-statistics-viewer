{
  "name": "user-level-metrics-viewer",
  "version": "0.1.0",
  "private": true,
  "imports": {
    "#domain/*": "./src/domain/*.ts",
    "#utils/*": "./src/utils/*.ts"
  },
  "scripts": {
    "dev": "npm run build:worker && next dev --turbopack",
    "build": "npm run build:worker -- --production && next build",
    "build:worker": "node scripts/build-worker.mjs",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "anonymize:report": "node --experimental-strip-types data-utils/anonymize-report.ts",
    "update:plugins": "node --experimental-strip-types data-utils/update-plugin-versions.ts"
  },
  "dependencies": {
    "chart.js": "^4.5.1",
    "next": "^16.3.5",
    "react": "^19.3.0",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-test-renderer": "19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "@vitest/ui": "^4.1.11",
    "esbuild": "^0.28.1",
    "eslint": "^10.8.1",
    "eslint-config-next": "^16.3.5",
    "playwright": "^1.63.0",
    "react-test-renderer": "19.3.0",
    "tailwindcss": "^4.3.3",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.2",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "overrides": {
    "flatted": "^3.4.2",
    "postcss": "8.5.28"
  }
}
